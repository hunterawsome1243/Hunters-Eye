# Copy to .env and fill in only what you need. Everything here is optional.

# Port the dashboard listens on.
PORT=3000

# Interface to listen on. 127.0.0.1 keeps it on this computer; 0.0.0.0 opens it to your network.
HOST=127.0.0.1

# Identifies the app to api.weather.gov and other feeds (NWS requires a User-Agent).
# Putting a contact URL or email in it lets an operator reach you if something goes wrong.
USER_AGENT=HuntersEye/0.1 (+https://github.com/hunterawsome1243/Hunters-Eye)

# OpenSky Network API client (free account -> Account page -> API client).
# Without these the aircraft layer runs anonymously: 400 credits/day, so a global
# refresh only every 15 minutes. With them: 4000 credits/day, refresh every 90 seconds.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Override a source's refresh interval (seconds). Leave blank for the safe defaults.
# EARTHQUAKES_INTERVAL_SEC=60
# AIRCRAFT_INTERVAL_SEC=
# WEATHER_INTERVAL_SEC=120

# When the server can't reach OpenSky or CelesTrak at all, browsers fetch those two
# feeds themselves. Set to off to stop that.
# BROWSER_FALLBACK=off

# Basemap drawn under the layers: any MapLibre style URL. Default: OpenFreeMap's
# free dark style, which needs no key.
# BASEMAP_STYLE=https://tiles.openfreemap.org/styles/dark

# Satellite imagery drawn on the globe from space down to about zoom 12. Default:
# EOX Sentinel-2 cloudless 2017 (free, no key, CC BY 4.0). Set IMAGERY_TILES= (empty)
# for no imagery, or another {z}/{x}/{y} tile URL with its credit line.
# IMAGERY_TILES=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2017_3857/default/g/{z}/{y}/{x}.jpg
# IMAGERY_ATTRIBUTION=
# IMAGERY_MAXZOOM=12

# Optional "Brief me" button: Claude writes a short situation brief of what the
# dashboard shows. Only this server talks to the API; the key never reaches the
# browser. Each brief costs about $0.0003 with Haiku 5.5 (see server/brief.js),
# capped at 20 briefs an hour. Leave empty and the button never appears.
ANTHROPIC_API_KEY=
# BRIEF_MODEL=claude-haiku-5-5
