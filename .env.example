# Copy to .env and fill in only what you need. Everything here is optional.

# Port the dashboard listens on.
PORT=3000

# Identifies the app to api.weather.gov and other feeds (NWS requires a User-Agent).
# Putting a contact URL or email in it lets an operator reach you if something goes wrong.
USER_AGENT=HuntersEye/0.1 (+https://github.com/hunterawsome1243/Hunters-Eye)

# OpenSky Network API client (free account -> Account page -> API client).
# Without these the aircraft layer runs anonymously: 400 credits/day, so a global
# refresh only every 15 minutes. With them: 4000 credits/day, refresh every 90 seconds.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Override a source's refresh interval (seconds). Leave blank for the safe defaults.
# EARTHQUAKES_INTERVAL_SEC=60
# AIRCRAFT_INTERVAL_SEC=
# WEATHER_INTERVAL_SEC=120
